# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   ./scripts/setup.sh   또는   cp .env.example .env
# .env 는 git 에 커밋되지 않습니다.
# 다른 컴퓨터에서 이어할 때: 기존 .env 내용을 붙여넣거나 Railway Variables 를 참고하세요.

# OpenAI(ChatGPT) API 키 — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 사용할 모델 / 설정을 코드가 아닌 여기서 덮어쓸 수 있음
# OPENAI_MODEL=gpt-4o-mini

# ── 이메일(Gmail SMTP) ──────────────────────────────
# 발신 Gmail 주소
EMAIL_SENDER=youraddress@gmail.com
# Gmail 앱 비밀번호 (일반 로그인 비번 아님!)
#   https://myaccount.google.com/apppasswords 에서 발급 (2단계 인증 필요)
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# 수신자 (여러 명이면 쉼표로 구분)
EMAIL_RECIPIENTS=recipient@example.com,other@example.com

# ── 텔레그램 (Railway 권장) ─────────────────────────
# 1) Telegram 에서 @BotFather → /newbot → 토큰 복사
# 2) 봇에게 아무 메시지 한 번 보내기
# 3) chat id 확인:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    result[0].message.chat.id
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# ── GitHub 자동 트리거 (백업) ───────────────────────
# Fine-grained PAT: Actions=Read and write, Contents=Read (opt-analysis only)
# GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Railway Volume 사용 시 (기본 Dockerfile 과 동일)
# SNAPSHOTS_DIR=/data/snapshots
