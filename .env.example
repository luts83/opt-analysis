# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 포함되어 커밋되지 않습니다.

# OpenAI(ChatGPT) API 키 — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 사용할 모델 / 설정을 코드가 아닌 여기서 덮어쓸 수 있음
# OPENAI_MODEL=gpt-4o-mini

# ── 이메일(Gmail SMTP) ──────────────────────────────
# 발신 Gmail 주소
EMAIL_SENDER=youraddress@gmail.com
# Gmail 앱 비밀번호 (일반 로그인 비번 아님!)
#   https://myaccount.google.com/apppasswords 에서 발급 (2단계 인증 필요)
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# 수신자 (여러 명이면 쉼표로 구분)
EMAIL_RECIPIENTS=recipient@example.com
